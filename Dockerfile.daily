FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ACCEPT_EULA=Y

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gnupg \
    apt-transport-https \
    unixodbc \
    unixodbc-dev \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
      > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends msodbcsql18 \
    && sed -i '/^\[openssl_init\]$/a ssl_conf = ssl_sect' /etc/ssl/openssl.cnf \
    && printf '\n[ssl_sect]\nsystem_default = system_default_sect\n\n[system_default_sect]\nCipherString = DEFAULT@SECLEVEL=0\n' >> /etc/ssl/openssl.cnf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements ./requirements
COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir -r requirements/prod.txt \
    && pip install --no-cache-dir -e .

# Key and .env are injected at runtime (Secret Manager), not baked into the image.
ENV FIREBASE_KEY_PATH=/secrets/serviceAccountKey.json

CMD ["python", "-m", "pos_pipeline.cli", "daily"]